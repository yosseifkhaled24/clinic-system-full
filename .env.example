APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# SECURITY (SEC-05): APP_DEBUG must be false in production — debug mode
# renders full stack traces, file paths and config to any visitor who
# triggers an error. Keep it true ONLY for local development. This is a
# deployment requirement: verify APP_DEBUG=false on every production
# host (the real .env is never modified by tooling).
APP_DEBUG=true
APP_URL=http://localhost

# SEC-03: origin of the Next.js frontend. Email-verification links are
# redirected to {FRONTEND_URL}/verify-email after the signed backend
# route validates them (e.g. http://localhost:3000).
FRONTEND_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail transport (SEC-03: REQUIRED in production for email verification).
# Verification emails are sent through this transport; if it is not
# configured, registration still succeeds but reports
# notification_sent=false and the user must use the resend action once
# the mail service is available. Configure a real provider for
# production, e.g.:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.example.com
#   MAIL_PORT=587
#   MAIL_USERNAME=<your smtp username>        (never commit real values)
#   MAIL_PASSWORD=<your smtp password>        (never commit real values)
#   MAIL_ENCRYPTION=tls
#   MAIL_FROM_ADDRESS="no-reply@your-clinic.com"
#   MAIL_FROM_NAME="${APP_NAME}"
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Stripe payment integration (required for checkout and webhook confirmation)
# STRIPE_SECRET_KEY / STRIPE_PUBLIC_KEY: from the Stripe dashboard.
#
# STRIPE_WEBHOOK_SECRET (SEC-06): the signing secret of the webhook
# endpoint (whsec_...). It is REQUIRED for online payments: without it,
# checkout and payment-status requests fail safely with 503
# ("online payments are not configured") and webhook deliveries are
# rejected — no secret is ever invented or hardcoded. Copy the value
# from Stripe > Developers > Webhooks for your endpoint; NEVER commit a
# real value.
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Gemini AI chatbot (public clinic assistant at POST /api/chatbot)
# The key is only ever read server-side and is never exposed to the frontend.
GEMINI_API_KEY=
# Optional overrides (defaults shown)
# Note: legacy models such as gemini-2.5-flash are rejected (404) for newer
# API keys; list available models via GET /v1beta/models with your key.
GEMINI_MODEL=gemini-3.1-flash-lite
# REST surface: generate_content (legacy /v1beta/models/{model}:generateContent)
# or interactions (POST /v1beta/interactions, snake_case Interactions API —
# docs: https://ai.google.dev/gemini-api/docs/interactions-overview).
# Only switch after a real request with the chosen model succeeds.
GEMINI_API=generate_content
GEMINI_TIMEOUT=30
